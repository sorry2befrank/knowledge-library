<Project Sdk="Microsoft.NET.Sdk">
  <!-- kl-fs: the native file helper (DESIGN §2.3, §6.8). Built in CI from this source; never committed as a binary. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>kl-fs</AssemblyName>
    <RootNamespace>KlFs</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>CA1416</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/kl-fs</PathMap>
  </PropertyGroup>
</Project>
