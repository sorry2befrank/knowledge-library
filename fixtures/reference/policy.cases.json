    {"id": "private-overlay-audit-pattern", "operation": "synthetic-overlay-directory", "input": "sample-area-red-audit-copy", "expected": "denied"},
    {"id": "private-overlay-path", "operation": "synthetic-overlay-path", "relativePath": "sample/sample-owner-ops/overview.md", "expected": "denied"},
