{
  "schema": "reference-fixture-cases/v1",
  "subject": "knowledge-library-deny-reference/v1",
  "constructionGrammar": "String values are literals. Objects with concat or repeat are constructed recursively; repeat is [value,count]. Credential-shaped inputs are constructed only in isolated test memory.",
  "executionStatus": "Expected results reflect inspected legacy declarations and stated library adaptations; no source module or production test executed.",
  "syntheticOverlay": {
    "approved": true,
    "revision": "synthetic-overlay-v1",
    "deniedDirectorySegments": ["sample-private"],
    "auditDirectoryPatterns": [{"source": "^sample-area-(?:.*-)?audit-", "flags": "i"}],
    "privateOperationalPathSignatures": ["/sample-owner-ops/"]
  },
  "cases": [
    {"id": "dependency-directory", "operation": "generic-directory-segment", "input": "node_modules", "expected": "denied"},
    {"id": "directory-case-fold", "operation": "generic-directory-segment", "input": "LOGS", "expected": "denied"},
    {"id": "directory-not-substring", "operation": "generic-directory-segment", "input": "build-notes", "expected": "allowed-by-this-check"},
    {"id": "unsupported-extension", "operation": "extension", "input": ".png", "expected": "denied"},
    {"id": "supported-extension", "operation": "extension", "input": ".MD", "expected": "allowed-by-this-check"},
    {"id": "environment-basename", "operation": "basename", "input": ".env.local", "expected": "denied"},
    {"id": "credential-basename", "operation": "basename", "input": "credentials.md", "expected": "denied"},
    {"id": "token-basename", "operation": "basename", "input": "access-token.md", "expected": "denied"},
    {"id": "key-basename", "operation": "basename", "input": "identity.key", "expected": "denied"},
    {"id": "legacy-broad-backup-false-positive", "operation": "basename", "input": "backup-plan.md", "expected": "denied"},
    {"id": "ordinary-basename", "operation": "basename", "input": "overview.md", "expected": "allowed-by-this-check"},
    {"id": "record-path", "operation": "legacy-guard", "relativePath": "sample/intake/overview.md", "text": "Ordinary sample text.", "expected": {"flagged": true, "secret": false, "reasons": ["record-path"]}},
    {"id": "uploads-case-and-backslashes", "operation": "legacy-guard", "relativePath": "sample\\UPLOADS\\overview.md", "text": "Ordinary sample text.", "expected": {"flagged": true, "secret": false, "reasons": ["record-path"]}},
    {"id": "path-marker-not-partial-segment", "operation": "legacy-guard", "relativePath": "sample/intakes/overview.md", "text": "Ordinary sample text.", "expected": {"flagged": false, "secret": false, "reasons": []}},
    {"id": "one-record-signature", "operation": "legacy-guard", "relativePath": "sample/overview.md", "text": "An IEP reference.", "expected": {"flagged": false, "secret": false, "reasons": []}},
    {"id": "repeated-signature-still-one", "operation": "legacy-guard", "relativePath": "sample/overview.md", "text": "IEP IEP IEP", "expected": {"flagged": false, "secret": false, "reasons": []}},
    {"id": "two-distinct-record-signatures", "operation": "legacy-guard", "relativePath": "sample/overview.md", "text": "Date of birth and an IEP reference.", "expected": {"flagged": true, "secret": false, "reasons": ["record-signatures"]}},
    {"id": "signature-word-boundary", "operation": "legacy-guard", "relativePath": "sample/overview.md", "text": "An IEPish topic and grade level.", "expected": {"flagged": false, "secret": false, "reasons": []}},
    {"id": "constructed-api-prefix", "operation": "legacy-guard", "relativePath": "sample/overview.md", "text": {"concat": ["sk-", {"repeat": ["A", 24]}]}, "expected": {"flagged": false, "secret": true, "reasons": ["credential-pattern"]}},
    {"id": "constructed-project-api-prefix", "operation": "legacy-guard", "relativePath": "sample/overview.md", "text": {"concat": ["sk-", "proj-", {"repeat": ["A", 24]}]}, "expected": {"flagged": false, "secret": true, "reasons": ["credential-pattern"]}},
    {"id": "constructed-provider-prefix", "operation": "legacy-guard", "relativePath": "sample/overview.md", "text": {"concat": ["gh", "p_", {"repeat": ["A", 30]}]}, "expected": {"flagged": false, "secret": true, "reasons": ["credential-pattern"]}},
    {"id": "constructed-cloud-prefix", "operation": "legacy-guard", "relativePath": "sample/overview.md", "text": {"concat": ["AK", "IA", {"repeat": ["A", 16]}]}, "expected": {"flagged": false, "secret": true, "reasons": ["credential-pattern"]}},
    {"id": "constructed-private-key-header", "operation": "legacy-guard", "relativePath": "sample/overview.md", "text": {"concat": ["-----BEG", "IN ", "PRIVATE KEY-----"]}, "expected": {"flagged": false, "secret": true, "reasons": ["credential-pattern"]}},
    {"id": "constructed-authorization-header", "operation": "legacy-guard", "relativePath": "sample/overview.md", "text": {"concat": ["Authorization: Bearer ", {"repeat": ["A", 24]}]}, "expected": {"flagged": false, "secret": true, "reasons": ["credential-pattern"]}},
    {"id": "constructed-assignment", "operation": "legacy-guard", "relativePath": "sample/overview.md", "text": {"concat": ["password=", {"repeat": ["A", 24]}]}, "expected": {"flagged": false, "secret": true, "reasons": ["credential-pattern"]}},
    {"id": "below-legacy-length-threshold", "operation": "legacy-guard", "relativePath": "sample/overview.md", "text": {"concat": ["sk-", {"repeat": ["A", 23]}]}, "expected": {"flagged": false, "secret": false, "reasons": []}, "caveat": "A legacy signal miss is not clearance; shorter real secrets may still be sensitive."},
    {"id": "credential-reason-precedes-record-reason", "operation": "legacy-guard", "relativePath": "sample/intake/overview.md", "text": {"concat": ["Authorization: Bearer ", {"repeat": ["A", 24]}]}, "expected": {"flagged": true, "secret": true, "reasons": ["credential-pattern"]}},
