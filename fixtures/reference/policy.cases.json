    {"id": "student-input-never-saved-to-private-inbox", "operation": "library-admission", "inputs": {"synthetic": false, "overlayApproved": true, "scopeAllowed": true, "clientApproved": true, "secret": false, "flagged": true}, "expected": "reject-before-persistence"},
    {"id": "credential-input-never-saved", "operation": "library-admission", "inputs": {"synthetic": false, "overlayApproved": true, "scopeAllowed": true, "clientApproved": true, "secret": true, "flagged": false}, "expected": "reject-before-persistence"},
    {"id": "client-unclassified-blocks-admission", "operation": "library-admission", "inputs": {"synthetic": false, "overlayApproved": true, "scopeAllowed": true, "clientApproved": false, "secret": false, "flagged": false}, "expected": "reject-before-persistence"},
    {"id": "all-admission-prerequisites", "operation": "library-admission", "inputs": {"synthetic": false, "overlayApproved": true, "scopeAllowed": true, "clientApproved": true, "secret": false, "flagged": false}, "expected": "allowed-by-these-checks", "caveat": "Separate authorization, source integrity, byte bounds, encoding and adapter checks still apply."}
  ]
